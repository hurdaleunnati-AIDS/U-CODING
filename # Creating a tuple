# Creating a tuple
my_tuple = (10, 20, 30, 20, 40)

# 1. count() - counts occurrences of an element
print(my_tuple.count(20))

# 2. index() - returns the index of an element
print(my_tuple.index(30))

# 3. len() - returns the length of tuple
print(len(my_tuple))

# 4. Accessing an element using index
print(my_tuple[0])

# 5. Slicing - gets a part of the tuple
print(my_tuple[1:4])
